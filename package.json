{
  "name": "asteria-launcher",
  "version": "1.5.4",
  "main": "electron/main.cjs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "vite build && electron-builder --win nsis --x64",
    "release": "vite build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@xhayper/discord-rpc": "^1.2.0",
    "adm-zip": "^0.4.16",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.0",
    "minecraft-launcher-core": "^3.18.2",
    "minecraft-server-util": "^5.4.0",
    "msmc": "^5.0.5",
    "prismarine-nbt": "^2.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.0",
    "vite": "^5.3.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "ru.safimine.asteria",
    "productName": "AsteriaLauncher",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "FilonisSF",
        "repo": "AsteriaLauncher",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "mods/dist",
        "to": "mods",
        "filter": [
          "asteria-core-*.jar",
          "asteria-visuals-*.jar"
        ]
      }
    ]
  }
}
